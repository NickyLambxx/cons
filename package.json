{
  "name": "prepmate-constitution",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build:qr": "esbuild scripts/qr-browser-entry.js --bundle --minify --format=iife --outfile=js/vendor/qrcode.js",
    "check:js": "node scripts/check-js.mjs",
    "test": "node --test tests/*.test.mjs",
    "check": "node scripts/check-js.mjs && node --test tests/*.test.mjs",
    "predeploy": "node scripts/check-js.mjs && node --test tests/*.test.mjs",
    "smoke:live": "node scripts/smoke-live.mjs v55",
    "smoke:live:ui": "node scripts/smoke-live-ui.mjs && node scripts/smoke-lesson-ui.mjs && node scripts/smoke-reference-ui.mjs"
  },
  "devDependencies": {
    "esbuild": "^0.28.1",
    "playwright-core": "1.58.2",
    "qrcode": "^1.5.4"
  }
}
